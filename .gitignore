# See https://help.github.com/articles/ignoring-files/ for more about ignoring files.

# dependencies
/node_modules
/.pnp
.pnp.*
.yarn/*
!.yarn/patches
!.yarn/plugins
!.yarn/releases
!.yarn/versions

# testing
/coverage

# next.js
/.next/
/out/

# production
/build

# misc
.DS_Store
*.pem

# debug
npm-debug.log*
yarn-debug.log*
yarn-error.log*
.pnpm-debug.log*

# env files (can opt-in for committing if needed)
.env*
# .env.example gerçek sır içermez; yeni geliştiricinin şablonu olduğu için izlenir.
!.env.example

# Prisma tarafından üretilen istemci — `npm run db:generate` ile yeniden üretilir.
/src/generated

# Geliştirme aracının yerel ayarları (önizleme sunucusu tanımı vb.)
/.claude

# vercel
.vercel

# typescript
*.tsbuildinfo
next-env.d.ts

/src/generated/prisma

# Rapor doğrulama çıktıları (PDF ve gövde JSON) — üretilmiş, sürümlenmez
scripts/test-verisi/cikti/

# Rapor belgesinin gözle denenmesi için üretilen örnek çıktı (npm run rapor:ornek)
ornek-rapor.pdf

# Geçmiş veri aktarımının ara çıktıları — veli telefonları içerir.
scripts/gecmis-veri/cikti/
