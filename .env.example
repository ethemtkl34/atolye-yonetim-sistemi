# Veritabanı bağlantısı.
# Yerel geliştirme: `docker compose up -d` ile ayağa kalkan Postgres.
# Üretim: Supabase proje ayarlarındaki connection string.
DATABASE_URL="postgresql://tuzder:tuzder@localhost:5433/tuzder?schema=public"

# Auth.js oturum şifreleme anahtarı. Üretimde mutlaka değiştirin.
# Yeni bir anahtar üretmek için: openssl rand -base64 32
AUTH_SECRET="gelistirme-ortami-icin-gecici-anahtar-degistirin"

# Uygulamanın çalıştığı adres. Üretimde Vercel alan adı.
#
# Giriş sonrası yönlendirme buradan türetilir. Uygulamayı yalnızca kendi
# bilgisayarınızda kullanacaksanız localhost yeterli:
AUTH_URL="http://localhost:3000"
#
# Aynı wifi'daki telefon/tabletten de girilecekse bilgisayarın ağ adresini
# yazın — örn. AUTH_URL="http://10.42.30.97:3000". Adresi öğrenmek için:
#   ipconfig getifaddr en0
# localhost yazılı kalırsa telefonda parola kabul edilir ama giriş sonrası
# yönlendirme telefonun kendisine gider ve giriş ekranından çıkılamaz.
# (`trustHost: true` bunu çözmüyor; Auth.js taban adresi istek başlığından
# değil bu değişkenden türetiyor — denendi.)

# Kurum adı — PDF raporların üst bilgisinde kullanılır.
NEXT_PUBLIC_KURUM_ADI="TÜZDER"
