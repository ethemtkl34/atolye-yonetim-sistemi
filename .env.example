# Veritabanı bağlantısı.
# Yerel geliştirme: `docker compose up -d` ile ayağa kalkan Postgres.
# Üretim: Supabase proje ayarlarındaki connection string.
DATABASE_URL="postgresql://tuzder:tuzder@localhost:5433/tuzder?schema=public"

# Auth.js oturum şifreleme anahtarı. Üretimde mutlaka değiştirin.
# Yeni bir anahtar üretmek için: openssl rand -base64 32
AUTH_SECRET="gelistirme-ortami-icin-gecici-anahtar-degistirin"

# Uygulamanın çalıştığı adres. Üretimde Vercel alan adı.
AUTH_URL="http://localhost:3000"

# Kurum adı — PDF raporların üst bilgisinde kullanılır.
NEXT_PUBLIC_KURUM_ADI="TÜZDER"
