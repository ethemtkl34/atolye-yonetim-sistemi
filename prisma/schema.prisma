// Atölye Yönetim Sistemi — veri modeli
//
// Model ve alan adları İngilizce, enum değerleri ise doküman diliyle birebir
// eşleşsin diye Türkçe. Her tasarım kararının karşılığı docs/PROJECT_SPEC.md
// içindeki madde numarasıyla birlikte yazıldı.

generator client {
  provider = "prisma-client"
  output   = "../src/generated/prisma"
}

datasource db {
  provider = "postgresql"
}

// ---------------------------------------------------------------------------
// Enum'lar
// ---------------------------------------------------------------------------

/// §3 — Roller.
///
/// Sistem tek merkez için yazıldığında admin ve koordinatör tek rolde
/// birleştirilmişti; kurum iki şubeye çıkınca bu karar geri alındı. Ümraniye
/// kadrosunun yetkilendirme matrisiyle rol seti altıya çıktı ve bir kullanıcı
/// birden çok rol taşıyabilir oldu (`User.roles`, örn. psikolog + test
/// uygulayıcısı). Her rolün modül bazlı yetkileri `src/lib/yetkiler.ts`
/// içindeki matriste tanımlıdır; etkin yetki rollerin birleşimidir.
///
/// Enum değerleri ilk üç rolde ESKİ adlarıyla duruyor (ADMIN ≙ "Kurum
/// Yöneticisi", KOORDINATOR ≙ "Atölye Koordinatörü"): üretim veritabanında
/// enum değeri yeniden adlandırmak backfill ve CHECK yeniden yazımı gerektirir,
/// görünen ad zaten `ROL_ADLARI`'ndan geliyor.
///
/// Kombinasyon kuralları (CHECK ile de zorlanır, bkz. migration `coklu_rol`):
/// ADMIN tek başınadır ve şubesizdir; STAJYER tek başınadır (kendi paneli);
/// kalan beş rol serbestçe birleşir ve her zaman bir şubeye bağlıdır.
///
/// SUBE_YONETICISI ("Şube Yöneticisi") kurum iki şubeyle yürümeye başlayınca
/// eklendi: şubenin başındaki kişi kendi kadrosunu açıp kapatabilmeli ama
/// diğer şubeyi görmemeli. Kurum Yöneticisi'nden farkı tek şubeye bağlı
/// olması, koordinatörden farkı kullanıcı yönetimini taşıması.
enum Role {
  KOORDINATOR
  STAJYER
  ADMIN
  ATOLYE_PSIKOLOGU
  TEST_UYGULAYICISI
  DANISMA_GOREVLISI
  SUBE_YONETICISI
}

/// §4.3
enum TermStatus {
  TASLAK
  KAYIT_ALIYOR
  DEVAM_EDIYOR
  TAMAMLANDI
  ARSIVLENDI
}

/// §5.3
enum ClubStatus {
  TASLAK
  KAYIT_ALIYOR
  TAMAMLANDI
  IPTAL_EDILDI
  ARSIVLENDI
}

/// Programın toplandığı gün.
///
/// Sistem başlangıçta yalnızca hafta sonunu tanıyordu (§2.3) çünkü dönemler
/// cumartesi–pazar yürüyordu. Yaz programları hafta içi yapılıyor; enum yedi
/// güne çıktı ve hangi günlerin seçilebileceği artık dönemin `dayMode`
/// alanından geliyor.
///
/// Sıra takvim sırası: `orderBy` ve gün listeleri bu sıraya güveniyor.
enum Day {
  PAZARTESI
  SALI
  CARSAMBA
  PERSEMBE
  CUMA
  CUMARTESI
  PAZAR
}

/// Dönemin gün düzeni — grup açarken hangi günlerin sunulacağını belirler.
///
/// Sezon (sonbahar/yaz) etiketi olarak DEĞİL, işlevsel bir alan olarak
/// duruyor: dönem adı zaten serbest metin, sezonu oradan okunuyor. Burada
/// kararlaştırılan şey takvimde ve grup formunda hangi günlerin görüneceği.
enum DayMode {
  HAFTA_SONU
  HAFTA_ICI
}

/// §2.3 — Atölyelerin dakika bazlı saati tutulmaz (§14), yalnızca yarım gün.
enum TimeSlot {
  OGLEDEN_ONCE
  OGLEDEN_SONRA
}

enum GuardianType {
  ANNE
  BABA
}

/// Çocuğun ebeveynlerinin birliktelik durumu — danışan başvurusunda alınır.
/// Serbest metin yerine etiket: terapide "ayrı yaşayan ebeveyn" bilgisi
/// süzülebilir ve sayılabilir olmalı. DIGER, listeye sığmayan durumlar için
/// (vasi yanında kalma, koruyucu aile) açık kapı bırakıyor; ayrıntısı
/// `livesWith` alanına yazılır.
enum ParentStatus {
  BIRLIKTE
  AYRI
  BOSANMIS
  VEFAT
  DIGER
}

enum EnrollmentStatus {
  AKTIF
  IPTAL
}

/// Görüşmeyi kimin yaptığı — psikolog mu, koordinatör mü.
///
/// Psikologlar sistemde kullanıcı DEĞİL; görüşmeci adı serbest metin
/// (`CounselingSession.counselorName`). Etiket ayrıca tutuluyor çünkü
/// "kaç görüşme psikologla yapıldı" sorusu ancak sayılabilir bir alandan
/// cevaplanır.
enum CounselorType {
  PSIKOLOG
  KOORDINATOR
}

/// Terapi görüşmesinin türü — "bu dönem kaç oyun terapisi yapıldı" sorusu
/// ancak sayılabilir bir alandan cevaplanır. Görüşmeci türünden
/// (CounselorType) ayrı bir eksen: türlerin hepsini psikolog da koordinatör
/// de yürütebilir.
///
/// Liste kurumun hizmet yelpazesiyle değişiyor; arayüz tarafındaki etiket ve
/// adres slug'larının tek kaynağı `src/lib/terapi-turleri.ts` — buraya bir
/// tür eklemek o dosyayı da güncellemeyi gerektirir.
enum TherapyType {
  OYUN_TERAPISI
  ERGEN_TERAPISI
  ERGOTERAPI
  BILISSEL_MUDAHALE
  KISA_AILE_DANISMANLIGI
  UZUN_AILE_DANISMANLIGI
}

/// Kaydın neden iptal edildiği.
///
/// Serbest metin yerine etiket: "bu dönem kaç çocuk taşındığı için ayrıldı"
/// sorusu ancak sayılabilir bir alandan cevaplanır. Liste bilerek kısa —
/// uzun listede seçim yapmak zorlaşır ve etiketler birbirine karışır.
/// `DIGER` seçildiğinde açıklama zorunludur.
enum CancelReason {
  TASINMA
  SAGLIK
  AILEVI
  DEVAMSIZLIK
  DIGER
}

// ---------------------------------------------------------------------------
// Şubeler
// ---------------------------------------------------------------------------

/// Kurumun fiziksel şubesi (Ümraniye, Güneşli).
///
/// Şube sınırı yalnızca üç tabloda doğrudan durur: `User`, `Group`, `Student`.
/// Kayıt, oturum, puanlama ve raporun şubesi ilişkiden türetilir — kayıt
/// grubundan, rapor öğrencisinden. Dönem, kulüp, atölye çeşidi ve
/// değerlendirme soruları ise ORTAKTIR: kurum aynı programı iki konumda
/// uyguluyor, her şube o programın içinde kendi gruplarını açıyor.
///
/// Silme yok, `active: false` var: bir şubenin kapanması geçmiş öğrenci ve
/// puanlama verisini yok etmemeli. Bütün ilişkiler bu yüzden `Restrict`.
model Branch {
  id String @id @default(cuid())

  /// Migration ve seed'in tutunduğu değişmez anahtar. `name` kurum tarafından
  /// değiştirilebilir, `code` değiştirilmez.
  code String @unique
  name String @unique

  active    Boolean  @default(true)
  sortOrder Int      @default(0)
  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  users    User[]
  students Student[]
  groups   Group[]
  leads    Lead[]
  veliler  Veli[]
  uzmanlar UzmanSube[]
  uzmanMesailer UzmanMesai[]

  @@index([active, sortOrder])
}

// ---------------------------------------------------------------------------
// Kullanıcılar
// ---------------------------------------------------------------------------

/// Bütün kullanıcılar aynı tabloda tutulur; ayrım `roles` dizisindedir.
/// Stajyerin kendi hesabı olması gerekiyor çünkü puanlamayı kendisi giriyor.
model User {
  id           String @id @default(cuid())
  email        String @unique
  passwordHash String
  name         String

  /// Yetkinin TEK kaynağı. Birden çok rol taşınabilir (örn. psikolog + test
  /// uygulayıcısı); etkin yetki `yetkileriHesapla()` ile rollerin birleşimi
  /// olarak hesaplanır. Boş dizi olamaz (`User_rol_dolu` CHECK).
  roles Role[]

  /// GEÇİŞ ARTIĞI — kod okumaz ve yazmaz. Çoklu role geçişte `roles`'a
  /// kopyalandı; eski kod deploy penceresinde kırılmasın diye nullable
  /// bırakıldı. Temizlik migration'ı bu sütunu ve eski indekslerini düşürecek.
  role Role?

  /// İlk girişte (veya yönetici parola sıfırladığında) parola değişimi
  /// zorunlu mu. Doluysa `girisZorunlu()` kullanıcıyı `/parola-degistir`
  /// sayfasına yönlendirir; başka hiçbir sayfa açılmaz.
  mustChangePassword Boolean @default(false)

  active    Boolean  @default(true)
  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  /// ADMIN (Kurum Yöneticisi) hiçbir şubeye bağlı değildir (null); diğer
  /// bütün roller her zaman bir şubeye bağlıdır. Kural veritabanında CHECK
  /// ile de zorlanıyor (bkz. migration `coklu_rol`: `User_yonetici_sube_kurali`).
  branchId String?
  branch   Branch? @relation(fields: [branchId], references: [id], onDelete: Restrict)

  /// §8 — Stajyer ataması kayıt bazındadır, öğrenci profiline bağlı değildir.
  assignedEnrollments          Enrollment[]            @relation("AtananStajyer")
  enteredScores                Score[]                 @relation("PuanlamayiGiren")
  editedReports                Report[]                @relation("RaporuDuzenleyen")
  addedCounselingSessions      CounselingSession[]     @relation("GorusmeyiEkleyen")
  addedParentMeetings          ParentMeeting[]         @relation("VeliGorusmesiEkleyen")
  addedTherapyIntakes          TherapyIntake[]         @relation("DanisanBasvurusuEkleyen")
  addedIntelligenceTests       IntelligenceTest[]      @relation("ZekaTestiEkleyen")
  filledDevelopmentAssessments DevelopmentAssessment[] @relation("GelisimiDolduran")
  generatedWorkshopContents    AtolyeIcerigi[]         @relation("AtolyeIcerigiUreten")
  termAssignments              TermIntern[]            @relation("DonemStajyeri")
  updatedReportSettings        RaporAyari[]            @relation("RaporAyariniGuncelleyen")
  assignedLeads                Lead[]                  @relation("AdayiUstlenen")
  createdLeads                 Lead[]                  @relation("AdayiEkleyen")
  addedLeadActivities          LeadActivity[]          @relation("AdayEtkinliginiEkleyen")
  /// Panele giren uzmanın hesabı — çoğu uzmanda boş (bkz. Uzman şerhi).
  uzmanProfili                 Uzman?                  @relation("UzmanHesabi")
  addedIzinler                 Izin[]                  @relation("IzniEkleyen")

  // Eski `role` indeksleri sütunla birlikte temizlik migration'ında düşecek.
  @@index([role, active])
  @@index([branchId, role, active])
  @@index([roles], type: Gin)
}

// ---------------------------------------------------------------------------
// Atölye kataloğu ve değerlendirme soruları
// ---------------------------------------------------------------------------

/// §2.1 — Kurumun tekrar kullandığı ana atölye tanımı.
model WorkshopType {
  id          String   @id @default(cuid())
  name        String   @unique
  description String?
  /// Pasife alınan atölye yeni programlarda seçilemez ama geçmişte kalır.
  active      Boolean  @default(true)
  sortOrder   Int      @default(0)
  createdAt   DateTime @default(now())
  updatedAt   DateTime @updatedAt

  questions         Question[]
  termWorkshops     TermWorkshop[]
  clubWorkshops     ClubWorkshop[]
  sessions          Session[]
  curriculumEntries CurriculumEntry[]
  atolyeIcerikleri  AtolyeIcerigi[]
  oneriUrunleri     OneriUrunu[]

  @@index([active, sortOrder])
}

/// §9.1 — Her atölye çeşidinin kendine ait, bağımsız düzenlenebilen soru seti.
model Question {
  id             String       @id @default(cuid())
  workshopTypeId String
  workshopType   WorkshopType @relation(fields: [workshopTypeId], references: [id], onDelete: Cascade)
  text           String
  /// Kısa başlık (örn. "Duygu Düzenleme"). Rapor düzyazısı ve kompakt
  /// listeler soru cümlesi yerine bunu kullanır; tek parçalı sorularda boş.
  title          String?
  /// Konu başlığı — `SORU_KATEGORILERI` listesinden biri ("İlgi ve Merak
  /// Alanları" / "Yetenek Gelişim Alanları"). Zorunlu: rapor kademeleri bu
  /// ada göre gruplanır. Liste dışı değer migration'daki CHECK kısıtına takılır.
  category       String
  sortOrder      Int          @default(0)
  active         Boolean      @default(true)
  createdAt      DateTime     @default(now())
  updatedAt      DateTime     @updatedAt

  answers ScoreAnswer[]

  @@index([workshopTypeId, active, sortOrder])
}

// ---------------------------------------------------------------------------
// Dönem
// ---------------------------------------------------------------------------

/// §2.2 — 10 eğitim haftasından oluşan ana program.
model Term {
  id          String     @id @default(cuid())
  name        String
  description String?
  status      TermStatus @default(TASLAK)

  /// Grupların hangi günlerde toplanabileceği. Dönem oluşturulurken seçilir;
  /// takvimdeki hafta gösterimi ve grup formundaki gün listesi buna göre
  /// daralır. Eski dönemlerin hepsi hafta sonu.
  dayMode DayMode @default(HAFTA_SONU)

  /// Rapor kapağında basılan eğitim yılı ("2025-2026"). Dönem adına gömmek
  /// yerine ayrı tutuluyor: kapakta kendi satırı var ve dönem adı
  /// ("Kış 1. Kur") yıldan bağımsız değişebiliyor. Eski dönemlerde boş.
  egitimYili String?

  /// Panel açılmadan önce yaşanmış, dışarıdan aktarılmış dönem.
  ///
  /// Bu dönemlerin haftası, oturumu ve puanı YOK — geçmişin kanıtı arşivdeki
  /// PDF'in kendisi (`LegacyReport`). Bayrak üç kapıyı birden kapatır: rapor
  /// kapsam listesi, rapor üretme eylemi, müfredat/puanlama seçicileri.
  /// `status: ARSIVLENDI` bunu tek başına yapamazdı; arşiv geri alınabilir
  /// bir görünürlük ayarı, oysa bu dönemlerin puanı hiçbir zaman gelmeyecek.
  gecmisVerisi Boolean @default(false)

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  workshops         TermWorkshop[]
  weeks             TermWeek[]
  groups            Group[]
  interns           TermIntern[]
  curriculumEntries CurriculumEntry[]
  atolyeIcerikleri  AtolyeIcerigi[]

  @@index([status])
}

/// Dönemin stajyer kadrosu. Her dönemin kendi stajyerleri vardır; bu dönemin
/// kayıtlarında sorumlu stajyer (`Enrollment.internId`) bu kadrodan seçilir.
/// Kadro boşsa kısıt uygulanmaz — stajyer ataması olmayan eski dönemler bütün
/// aktif stajyerlerle çalışmaya devam eder.
model TermIntern {
  id     String @id @default(cuid())
  termId String
  term   Term   @relation(fields: [termId], references: [id], onDelete: Cascade)
  userId String
  /// Cascade değil: stajyer hesabı silinirse kadro satırı da düşer ama bu
  /// zaten Enrollment.internId'deki SetNull ile aynı senaryonun devamıdır.
  user   User   @relation("DonemStajyeri", fields: [userId], references: [id], onDelete: Cascade)

  createdAt DateTime @default(now())

  @@unique([termId, userId])
  @@index([userId])
}

/// §13.3 — Aynı dönemin bütün grupları aynı 5 atölyeyi kullanır; bu yüzden
/// atölye seçimi gruba değil döneme bağlıdır. "Tam 5 adet" kuralı uygulama
/// katmanında doğrulanır (veritabanı satır sayısı kısıtlayamaz).
model TermWorkshop {
  id             String       @id @default(cuid())
  termId         String
  term           Term         @relation(fields: [termId], references: [id], onDelete: Cascade)
  workshopTypeId String
  /// Restrict: bir programda kullanılan atölye çeşidi silinemez.
  workshopType   WorkshopType @relation(fields: [workshopTypeId], references: [id], onDelete: Restrict)
  sortOrder      Int          @default(0)

  /// Bu dönemde bu atölyeyi veren öğretmen — serbest metin (`counselorName`
  /// ilkesi: öğretmenler sistemde kullanıcı hesabı değil). Her dönem farklı
  /// öğretmen gelebildiği için ad döneme değil dönem-atölye satırına yazılır.
  teacherName String?

  @@unique([termId, workshopTypeId])
  @@index([termId, sortOrder])
}

/// §2.2 — Eğitim yapılacak haftalar. Tatil haftaları seçilmediği için takvim
/// uzayabilir; bu yüzden tarihler tek tek tutulur, aralık değil.
///
/// `date` haftanın ÇAPASI: o haftanın PAZARTESİ tarihi. Eskiden cumartesiydi
/// (program yalnızca hafta sonu yapılırdı); hafta içi dönemler gelince çapa
/// haftanın başına alındı, böylece yedi günün hepsi aynı çapadan türetiliyor.
/// Grubun gerçek toplanma tarihi `grupTarihi(çapa, gün)` ile hesaplanır.
model TermWeek {
  id         String   @id @default(cuid())
  termId     String
  term       Term     @relation(fields: [termId], references: [id], onDelete: Cascade)
  weekNumber Int
  date       DateTime @db.Date

  sessions Session[]

  @@unique([termId, weekNumber])
  @@unique([termId, date])
  @@index([termId, weekNumber])
}

// ---------------------------------------------------------------------------
// Kulüp
// ---------------------------------------------------------------------------

/// §2.5 — Dönemden bağımsız, tek yarım günlük hazır program.
model Club {
  id   String @id @default(cuid())
  name String

  /// Kulübün İLK toplanma günü. `weekDates`'in ilk elemanıyla aynı tutulur;
  /// listeler ve kartlar tek bir tarih gösterdiği için ayrıca duruyor
  /// (sıralama da bunun üzerinden yapılıyor).
  date DateTime @db.Date

  /// Kulübün bütün toplanma günleri.
  ///
  /// Kulüp eskiden TEK yarım gündü; artık dönem gibi haftalara yayılabiliyor
  /// ve hafta sayısı serbest (1 de olur, 30 da). Ayrı bir `ClubWeek` tablosu
  /// açılmadı: kulüp haftasına bağlanan başka bir kayıt yok, liste grup
  /// açılırken oturum üretmek için okunuyor. Tablo, ilişkisi olmayan bir
  /// veri için fazladan bir katman olurdu.
  ///
  /// Liste kulüp açıldıktan sonra da düzenlenebilir (kulupler/
  /// takvim-eylemleri.ts): gün ekleme/silme/taşıma bütün grupların
  /// oturumlarına uygulanır ve sıra değişirse müfredat günüyle birlikte
  /// yeniden numaralanır.
  weekDates DateTime[] @db.Date

  description String?
  status      ClubStatus @default(TASLAK)

  /// Dışarıdan aktarılmış geçmiş kulüp — bkz. `Term.gecmisVerisi`.
  gecmisVerisi Boolean @default(false)

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  workshops         ClubWorkshop[]
  groups            Group[]
  curriculumEntries CurriculumEntry[]
  atolyeIcerikleri  AtolyeIcerigi[]

  @@index([status])
}

/// §13.6 — Bir kulüpte tam 3 atölye bulunur (uygulama katmanında doğrulanır).
model ClubWorkshop {
  id             String       @id @default(cuid())
  clubId         String
  club           Club         @relation(fields: [clubId], references: [id], onDelete: Cascade)
  workshopTypeId String
  workshopType   WorkshopType @relation(fields: [workshopTypeId], references: [id], onDelete: Restrict)
  sortOrder      Int          @default(0)

  /// Bu kulüpte bu atölyeyi veren öğretmen — serbest metin
  /// (bkz. TermWorkshop.teacherName).
  teacherName String?

  @@unique([clubId, workshopTypeId])
  @@index([clubId, sortOrder])
}

// ---------------------------------------------------------------------------
// Müfredat
// ---------------------------------------------------------------------------

/// Haftalık müfredat — bir programın (dönem VEYA kulüp) belirli bir haftasında
/// belirli bir atölyede işlenen/işlenecek konu. Doğrudan hafta bazında girilir;
/// konu havuzu ya da şablon kütüphanesi bilinçli olarak yok: her dönem farklı
/// öğretmen gelebildiği için müfredat döneme özgüdür (öğretmen adı
/// `TermWorkshop.teacherName` / `ClubWorkshop.teacherName` üzerinde durur).
///
/// `termId` ve `clubId` alanlarından tam olarak biri dolu olur; kural
/// migration içinde eklenen `CurriculumEntry_term_xor_club` CHECK kısıtıyla
/// veritabanında da zorlanır (Group modelindeki desenin aynısı).
///
/// Hafta çapası SAYIDIR (`weekNumber`), `TermWeek` FK'sı değil: puanlama
/// ekranları haftayı iki program türünde de `Session.weekNumber` üzerinden
/// okuyor ve kulübün hafta tablosu yok (hafta = `Club.weekDates` dizisindeki
/// 1 tabanlı sıra). Kulüp takvimi düzenlendiğinde sıra değişirse oturumlar
/// ve buradaki girdiler BİRLİKTE yeniden numaralanır — konu kendi gününü
/// takip eder (bkz. kulupler/takvim-eylemleri.ts). Telafi günlerinin hafta
/// numarası olmadığı için (`Session.weekNumber = null`) telafi gününde
/// müfredat gösterilmez.
///
/// Üst sınır (dönemde hafta sayısı, kulüpte gün sayısı) programa göre
/// değişken olduğundan uygulama katmanında doğrulanır ("tam 5 atölye"
/// kuralıyla aynı gerekçe). Programdan atölye çıkarılamaz, ancak DEĞİŞTİRİLİR
/// (sayı sabit); değiştirme eylemi eski atölyenin buradaki satırlarını ve
/// `AtolyeIcerigi` paragrafını da siler (bkz. mufredat/atolye-degistir-eylemi.ts).
///
/// Şubeden BAĞIMSIZDIR (dönem/kulüp gibi ortak): iki şube aynı programı aynı
/// müfredatla uygular.
model CurriculumEntry {
  id     String  @id @default(cuid())
  termId String?
  term   Term?   @relation(fields: [termId], references: [id], onDelete: Cascade)
  clubId String?
  club   Club?   @relation(fields: [clubId], references: [id], onDelete: Cascade)

  workshopTypeId String
  /// Restrict: TermWorkshop/ClubWorkshop ile aynı kural — programda
  /// kullanılan atölye çeşidi silinemez.
  workshopType   WorkshopType @relation(fields: [workshopTypeId], references: [id], onDelete: Restrict)

  /// Programın kaçıncı haftası (1'den başlar; `CurriculumEntry_hafta_pozitif`
  /// CHECK kısıtı). Dönemde `TermWeek.weekNumber`, kulüpte `weekDates`
  /// dizisindeki 1 tabanlı sıra ile eşleşir.
  weekNumber Int

  title       String
  description String?

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  // Hafta × atölye başına TEK girdi (birden çok konu gerekirse başlığa
  // yazılır). NULL sütun unique'e girmediği için dönem satırlarını ilk,
  // kulüp satırlarını ikinci indeks kısıtlar.
  @@unique([termId, weekNumber, workshopTypeId])
  @@unique([clubId, weekNumber, workshopTypeId])
}

// ---------------------------------------------------------------------------
// Grup
// ---------------------------------------------------------------------------

/// §2.3 — Bir döneme VEYA bir kulübe bağlı öğrenci topluluğu.
///
/// `termId` ve `clubId` alanlarından tam olarak biri dolu olur; bu kural
/// migration içinde eklenen `Group_term_xor_club` CHECK kısıtıyla veritabanı
/// seviyesinde zorlanır. Tek tablo kullanılmasının sebebi kayıt, oturum ve
/// puanlama mantığının dönem ve kulüp için aynı kod yolundan yürümesi.
model Group {
  id     String  @id @default(cuid())
  termId String?
  term   Term?   @relation(fields: [termId], references: [id], onDelete: Cascade)
  clubId String?
  club   Club?   @relation(fields: [clubId], references: [id], onDelete: Cascade)

  /// Şube sınırının asıl durduğu yer. Dönem ve kulüp ortaktır; grup değildir.
  /// `Enrollment`, `Session` ve dolayısıyla `Score`/`ScoreAnswer` şubelerini
  /// buradan türetir — bu yüzden gruba yazılan şube bütün operasyonel
  /// veriyi kapsar.
  branchId String
  branch   Branch @relation(fields: [branchId], references: [id], onDelete: Restrict)

  name String

  /// Grubun haftada toplandığı günler. En az bir gün olmak zorunda
  /// (`Group_gun_dolu` CHECK kısıtı).
  ///
  /// Tek alan değil liste: yaz programlarında bir grup haftada birden çok gün
  /// toplanıyor ve HER toplanma gününde dönemin bütün atölyeleri yapılıyor.
  /// Oturum sayısı bu yüzden gün sayısıyla çarpılır — 10 hafta × 2 gün ×
  /// 5 atölye = 100 oturum.
  days Day[]

  timeSlot TimeSlot
  capacity Int

  /// §13.5 — Dönem başladıktan sonra açılan grup geçmiş haftaları telafi
  /// etmez. 4. haftada açılan gruba yalnızca 4–10 haftaları için oturum
  /// üretilir. Kulüp grupları için her zaman 1'dir.
  startWeekNumber Int @default(1)

  active    Boolean  @default(true)
  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  enrollments Enrollment[]
  sessions    Session[]

  @@index([termId, branchId])
  @@index([clubId, branchId])
  @@index([branchId, active])
}

// ---------------------------------------------------------------------------
// Öğrenci
// ---------------------------------------------------------------------------

/// §6.1 — Öğrenci sisteme bir kez eklenir, birden fazla programa kaydolabilir.
model Student {
  id        String    @id @default(cuid())
  firstName String
  lastName  String
  birthDate DateTime? @db.Date
  school    String?
  grade     String?
  notes     String?

  /// §6.2 — Türkçe karakter duyarsız arama için normalize edilmiş ad soyad.
  /// `normalizeArama()` ile üretilir; "Şule Çınar" → "sule cinar".
  searchName String

  /// Öğrenci bir şubeye kayıtlıdır. Aynı çocuk iki şubede de eğitim alıyorsa
  /// iki ayrı kayıt olur; şubeler arası ortak öğrenci havuzu yok.
  branchId String
  branch   Branch @relation(fields: [branchId], references: [id], onDelete: Restrict)

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  guardians          Guardian[]
  healthInfo         HealthInfo?
  therapyIntake      TherapyIntake?
  enrollments        Enrollment[]
  reports            Report[]
  counselingSessions CounselingSession[]
  parentMeetings     ParentMeeting[]
  parentReferrals    ParentMeetingReferral[]
  intelligenceTests  IntelligenceTest[]
  legacyReports      LegacyReport[]
  /// Bu öğrenci bir adaydan dönüştüyse kaynağı — profildeki "aday geçmişi"
  /// kutusu ve kaynak raporu buradan okur.
  sourceLead         Lead?

  // Her öğrenci sorgusu artık şubeye bağlı; indeksler şube önekiyle.
  @@index([branchId, searchName])
  @@index([branchId, lastName, firstName])
}

/// §17.1 — Veli: adı, telefonu ve geçmişi olan BİRİNCİ SINIF kayıt.
///
/// Eskiden veli kimliği `Guardian` satırının içindeydi (ad + telefon,
/// öğrencinin altında). O modelde aynı anne-baba her çocuğu için ayrı bir
/// satırdı: canlıda 857 veli satırının 750 benzersiz telefonu vardı ve 58
/// telefon birden fazla çocuğa bağlıydı. Randevu velinin kendisine açıldığı
/// için (§17.4) bu bölünme velinin randevu geçmişini çocukları arasında
/// paylaştırırdı — kimlik bu yüzden buraya taşındı, `Guardian` bağ tablosuna
/// indirgendi.
///
/// Veli ŞUBEYE aittir: `Student` ile aynı gerekçe (§6.1) — iki şubede de
/// çocuğu olan veli iki kayıt olur, şubeler arası ortak veli havuzu yok.
model Veli {
  id String @id @default(cuid())

  branchId String
  branch   Branch @relation(fields: [branchId], references: [id], onDelete: Restrict)

  fullName String
  phone    String?

  /// §6.2 — Telefonla arama için yalnızca rakamlara indirgenmiş biçim.
  /// Mükerrer kilidi de bunun üzerinde: aynı şubede aynı telefon tek veli.
  searchPhone String?

  /// Türkçe karakterden arındırılmış ad — veli araması bu sütundan yapılır
  /// (`Student.searchName` ile aynı sözleşme).
  searchName String

  notes String?

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  guardians Guardian[]

  /// Kimlik anahtarı: şube + telefon + normalize ad.
  ///
  /// Yalnız telefon YETMİYOR. Canlı verinin kopyası üzerinde denendiğinde beş
  /// telefonun iki farklı ada bağlı olduğu, ikisinde de aynı numarayı anne ile
  /// babanın paylaştığı görüldü — telefona göre birleştirmek babanın adını
  /// siliyordu. Telefon bir cihaz, kimlik değil.
  ///
  /// Telefonsuz veliler kısıtın dışında kalır: Postgres'te NULL'lar birbirine
  /// eşit sayılmaz, dolayısıyla her telefonsuz veli kendi kaydıdır.
  @@unique([branchId, searchPhone, searchName])
  @@index([branchId, searchName])
}

/// §6.1 — Öğrenci ile velisi arasındaki bağ: hangi veli, hangi çocuğun
/// annesi/babası.
///
/// Ad ve telefon artık burada DEĞİL, `Veli` kaydında. Bu tablo yalnızca
/// ilişkiyi ve rolü taşıyor. En az bir ebeveyn telefonu zorunluluğu
/// (iki satırı birden kapsadığı için) hâlâ uygulama katmanında doğrulanır.
model Guardian {
  id        String       @id @default(cuid())
  studentId String
  student   Student      @relation(fields: [studentId], references: [id], onDelete: Cascade)
  veliId    String
  veli      Veli         @relation(fields: [veliId], references: [id], onDelete: Cascade)
  type      GuardianType

  @@unique([studentId, type])
  @@index([veliId])
}

/// §6.1 — Sağlık ve özel durum bilgileri.
///
/// GİZLİLİK (§3.2): `internSafetyNote` dışındaki bütün alanlar stajyerden
/// gizlidir. Bu, arayüzde saklamakla değil, stajyer rolündeki sorgularda bu
/// alanların `select` listesine hiç alınmamasıyla sağlanır.
model HealthInfo {
  id        String  @id @default(cuid())
  studentId String  @unique
  student   Student @relation(fields: [studentId], references: [id], onDelete: Cascade)

  allergies        String?
  medications      String?
  specialEducation String?
  healthNotes      String?
  emergencyInfo    String?

  /// Stajyerin görebildiği TEK alan — kısa ve uygulanabilir güvenlik uyarısı.
  internSafetyNote String?

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt
}

/// Öğrenci görüşmeleri — psikolog (veya koordinatör) ile öğrenci arasında
/// yapılan görüşmelerin kaydı. Veli görüşmeleri AYRI modelde (`ParentMeeting`):
/// yaşam döngüleri zıt — bu kayıt geçmişe dönüktür ve gelecek tarih kabul
/// etmez, veli görüşmesi ise görüşmeden ÖNCE brief hazırlamak için açılır.
///
/// GİZLİLİK (§3.2 ile aynı kural): görüşme notları sağlık bilgisi gibi
/// hassastır ve stajyerden TAMAMEN gizlidir. Bu, arayüzde saklamakla değil,
/// stajyer rolündeki sorguların select/include listesine bu ilişkinin hiç
/// alınmamasıyla sağlanır.
///
/// Görüşmeyi yapan kişi serbest metindir (`counselorName`): psikologlar
/// sistemde kullanıcı değil. Kaydı kimin girdiği ise ayrıca otomatik tutulur
/// (`createdBy`, SetNull — hesap silinse de görüşme kaydı kalır).
model CounselingSession {
  id        String  @id @default(cuid())
  studentId String
  student   Student @relation(fields: [studentId], references: [id], onDelete: Cascade)

  /// Görüşmenin yapıldığı gün. Gelecek tarih kabul edilmez: bu yapılmış bir
  /// görüşmenin kaydıdır, randevu defteri değil (uygulama katmanında doğrulanır).
  date DateTime @db.Date

  counselorName String
  counselorType CounselorType
  /// Görüşmenin hangi terapi türü kapsamında yapıldığı (bkz. TherapyType).
  therapyType   TherapyType
  notes         String

  createdByUserId String?
  createdBy       User?    @relation("GorusmeyiEkleyen", fields: [createdByUserId], references: [id], onDelete: SetNull)
  createdAt       DateTime @default(now())

  @@index([studentId, date])
}

/// Veli görüşmesi — dönem sürecinde veli ile yapılan "nasıl gidiyor" görüşmesi.
///
/// Öğrenci görüşmesinden (`CounselingSession`) farkı: kayıt görüşmeden ÖNCE,
/// görüşmeyi yapacak kişiye brief hazırlamak için açılır; gelecek tarih bu
/// yüzden geçerlidir. Serbest görüşme notu görüşmeden SONRA eklenir (`note`,
/// başta boş) — "sil + yeniden ekle" burada uymaz, not güncellenebilir.
///
/// GİZLİLİK (§3.2 ile aynı kural): veli görüşmeleri de sağlık bilgisi gibi
/// hassastır ve stajyerden TAMAMEN gizlidir; stajyer sorgularının
/// select/include listesine bu ilişki hiç alınmaz.
model ParentMeeting {
  id        String  @id @default(cuid())
  studentId String
  student   Student @relation(fields: [studentId], references: [id], onDelete: Cascade)

  /// Görüşmenin (planlanan) günü. Brief'in atölye özeti bu tarihe KADAR
  /// (dahil) yapılmış oturumlardan üretilir.
  date DateTime @db.Date

  /// Görüşmeyi yapacak kişi — serbest metin (`counselorName` ilkesi: veliyle
  /// görüşen herkes sistemde kullanıcı değil).
  interviewerName String

  /// Gözlem alanı puanları: `[{anahtar, soruMetni, baslik, deger}]`. Alan adı
  /// o günkü hâliyle donmuş (`questionTextSnapshot` ilkesi) — liste kodda
  /// değişse de geçmiş kayıt bozulmaz. 2026 Ağustos öncesi kayıtlarda üç
  /// soruluk mini testin cevapları var ve `baslik` alanı yok; okuma katmanı
  /// (`gozlemYorumuUret`) o durumda soru metnine düşer.
  answersJson Json

  /// Üretilen brief (`VeliBriefi`): gözlem yorumu + atölye özeti + görüşme
  /// çerçevesi + analiz, `Report.bodyJson` deseni. `metinKaynagi` P13'te "ai"
  /// olacak. Eski kayıtlarda gözlem paragrafları `miniTestParagraflari`
  /// adıyla duruyor; `veliBriefiCozumle` iki biçimi de okur.
  briefJson Json

  /// Görüşme formunun işaretleri ve serbest metinleri (`VeliGorusmeFormu`):
  /// mizaç özellikleri, bilişsel güçlü yönler, zorlanma alanları, atölye
  /// notları ve görüşme anındaki yaş/bant.
  ///
  /// NEDEN BRIEF'TEN AYRI: brief üretilmiş METİN, bu ise uzmanın verdiği
  /// KARAR. Metin sözlüğü ilerde revize edildiğinde hangi kutuların
  /// işaretlendiği tartışmasız kalmalı.
  ///
  /// Nullable: 2026 Ağustos öncesi kayıtlarda form yok, yalnızca mini test
  /// vardı. Eski kayıt geriye dönük doldurulmaz.
  formJson Json?

  /// Görüşme sonrası serbest not — kayıt anında boş, sonradan eklenir ve
  /// üzerine yazılabilir. Damgasız not olamaz (CHECK: `ParentMeeting_not_damgasi`).
  note          String?
  noteUpdatedAt DateTime?

  createdByUserId String?
  createdBy       User?    @relation("VeliGorusmesiEkleyen", fields: [createdByUserId], references: [id], onDelete: SetNull)
  createdAt       DateTime @default(now())

  referrals ParentMeetingReferral[]

  @@index([studentId, date])
}

/// Veli görüşmesinde alınan yönlendirme kararı — "bu dönem şuna yönlendirildi".
///
/// NEDEN AYRI SATIR (formJson'un içinde değil): yönlendirmenin ömrü görüşmeden
/// uzun. Kurumun formu bunları açıkça "öğrenci bir sonraki döneme geldiğinde
/// ekip ne konuşulmuş, ne önerilmiş bilgisine hızlıca ulaşsın" diye tutuyor;
/// bu soru ancak satırdan sorgulanır. JSON içine gömülseydi "geçen dönem kime
/// ergoterapi önerilmişti" sorusu tüm görüşmeleri okuyup ayrıştırmayı
/// gerektirirdi.
///
/// `studentId` bilerek denormalize: öğrencinin yönlendirme geçmişi profil
/// sayfasında görüşmelere join'lemeden, tek indeksli sorguyla çıkar.
///
/// GİZLİLİK: veli görüşmesiyle aynı sınıf — stajyer sorgularının
/// select/include listesine bu ilişki hiç alınmaz.
model ParentMeetingReferral {
  id        String        @id @default(cuid())
  meetingId String
  meeting   ParentMeeting @relation(fields: [meetingId], references: [id], onDelete: Cascade)

  studentId String
  student   Student @relation(fields: [studentId], references: [id], onDelete: Cascade)

  kind ReferralKind

  /// Kayıt anındaki tür etiketi (`questionTextSnapshot` ilkesi): hizmet listesi
  /// değişse veya bir tür kaldırılsa da geçmiş kayıt o günkü adı gösterir.
  label String

  /// Uzmanın gerekçesi / hangi atölye-kulüp olduğu gibi ayrıntı.
  note String?

  createdAt DateTime @default(now())

  /// Bir görüşmede aynı yönlendirme iki kez işaretlenemez.
  @@unique([meetingId, kind])
  @@index([studentId, createdAt])
}

/// Veli görüşmesinden çıkabilecek yönlendirmeler.
///
/// İlk altı değer `TherapyType` ile BİREBİR aynı olmak zorunda (kurumun
/// yürüttüğü terapiler); son üçü terapi olmayan yönlendirmeler. Etiketler ve
/// sıra `src/lib/yonlendirme-turleri.ts` içinde — oraya tür eklemek buraya da
/// migration ister.
enum ReferralKind {
  OYUN_TERAPISI
  ERGEN_TERAPISI
  ERGOTERAPI
  BILISSEL_MUDAHALE
  KISA_AILE_DANISMANLIGI
  UZUN_AILE_DANISMANLIGI
  ZEKA_TESTI
  ATOLYE
  KULUP
}

/// Danışan başvurusu — çocuk terapiye alınırken bir kez doldurulan bilgiler.
///
/// NEDEN AYRI MODEL: terapi danışanı olmak öğrencilikten bağımsız bir durum.
/// Psikologlar atölyeye hiç girmeyen çocuk da alıyor, atölyeden gelen çocuk da
/// sonradan terapiye başlayabiliyor. Bu alanlar `Student` üzerinde dursaydı
/// atölye öğrencilerinin çoğunda boş kalır, "başvurusu var mı" sorusu da
/// alanların doluluğundan tahmin edilirdi. Ayrı satır olunca kaydın VARLIĞI
/// cevabın kendisi olur ve başvuru çocuk sisteme girdikten aylar sonra da
/// açılabilir.
///
/// Öğrenci başına EN FAZLA BİR başvuru (`@unique`): bu bir görüşme kaydı değil,
/// çocuğun terapi dosyasının kapağı — terapi türü değişirse veya bilgi
/// güncellenirse üzerine yazılır. Seans seans biriken kayıt
/// `CounselingSession`da.
///
/// GİZLİLİK (§3.2): sağlık bilgisi kuralına tabi — stajyer sorgularına hiç
/// girmez, danışma görevlisi de göremez (`danismanlik` modülü yetkisi).
model TherapyIntake {
  id        String  @id @default(cuid())
  studentId String  @unique
  student   Student @relation(fields: [studentId], references: [id], onDelete: Cascade)

  /// Hangi terapi için başvurdu. Sonraki seansların türü değişebilir
  /// (`CounselingSession.therapyType`); bu alan başlangıç yönelimidir.
  therapyType TherapyType
  /// Ailenin/çocuğun başvuru nedeni, kendi cümleleriyle. Zorunlu: nedeni
  /// olmayan bir terapi başvurusu dosya değil, boş kayıttır.
  reason      String
  /// Kim yönlendirdi — okul, hekim, kendi başvurusu.
  referredBy  String?

  /// Daha önce alınan psikolojik/psikiyatrik destek: nereden, ne kadar süre.
  previousSupport String?
  /// Konmuş bir tanı varsa. Serbest metin — tanı listesi tutmak bu sistemin
  /// işi değil, yazan da hekim değil.
  diagnosis       String?

  /// Kardeş sayısı ve yaşları, serbest metin ("1 kız kardeş, 5 yaşında").
  siblings      String?
  /// Çocuğun kimlerle yaşadığı — ebeveyn durumu DIGER olduğunda ayrıntı buraya.
  livesWith     String?
  parentStatus  ParentStatus?
  /// Ailede ruhsal/nörolojik hastalık öyküsü.
  familyHistory String?

  /// Ebeveynlerin öğrenim durumu ve mesleği. `Guardian` satırına DEĞİL buraya
  /// yazılıyor: bilgi başvuru bağlamında alınıyor ve atölyeden gelen çocuğun
  /// başvurusu açılırken de aynı formdan geçiyor — Guardian'a taşınsaydı form
  /// iki ayrı kayda yazmak zorunda kalır, velisi olmayan öğrencide de kaybolurdu.
  motherEducation  String?
  motherOccupation String?
  fatherEducation  String?
  fatherOccupation String?

  createdByUserId String?
  createdBy       User?    @relation("DanisanBasvurusuEkleyen", fields: [createdByUserId], references: [id], onDelete: SetNull)
  createdAt       DateTime @default(now())
  updatedAt       DateTime @updatedAt
}

/// Zeka testi kataloğu — yükleme formundaki "Testin adı" açılır listesi.
///
/// Şubeden BAĞIMSIZDIR (atölye kataloğu gibi): kurum aynı test yelpazesini
/// iki şubede de uygular. Yönetim ekranı yok; liste şimdilik veritabanından
/// güncellenir (kurum isterse ekran sonra eklenir). Silme yerine
/// `active: false` — pasife alınan test yeni kayıtta seçilemez ama geçmiş
/// kayıtlar adını kendi satırında taşıdığı için bozulmaz
/// (`IntelligenceTest.testName` bir snapshot'tır).
model IntelligenceTestType {
  id        String   @id
  name      String   @unique
  active    Boolean  @default(true)
  sortOrder Int      @default(0)
  createdAt DateTime @default(now())

  @@index([active, sortOrder])
}

/// Zeka testi sonuç belgeleri — kuruma uygulanan testlerin (örn. WISC)
/// yüklenen PDF veya görsel dosyaları.
///
/// GİZLİLİK (§3.2 ile aynı kural): test sonuçları sağlık bilgisi gibi
/// hassastır ve stajyerden TAMAMEN gizlidir; stajyer sorgularının
/// select/include listesine bu ilişki hiç alınmaz.
///
/// Dosyanın ikili verisi veritabanında (`fileData`): sistemde ayrı bir nesne
/// deposu yok ve rapor PDF'leri de depo bağımlılığı olmadan çalışıyor.
/// Server Action + Vercel istek sınırı gereği dosya başına 4MB üst sınır
/// uygulama katmanında zorlanır. Daha büyük arşiv gerekirse nesne deposuna
/// (örn. Vercel Blob) geçilir; yalnızca bu alan ve indirme rotası değişir.
/// Liste sorguları `fileData`yı SEÇMEZ — megabaytlarca veri liste ekranına
/// taşınmamalı, dosya yalnızca indirme rotasından okunur.
model IntelligenceTest {
  id        String  @id @default(cuid())
  studentId String
  student   Student @relation(fields: [studentId], references: [id], onDelete: Cascade)

  /// Testin uygulandığı gün.
  date DateTime @db.Date

  /// Testin adı — kayıt anında katalogdan (`IntelligenceTestType`) seçilir
  /// ama burada METİN olarak donar (`questionTextSnapshot` ilkesi): katalog
  /// sonradan değişse veya test pasife alınsa da geçmiş kayıt o günkü adı
  /// gösterir.
  testName String

  /// İsteğe bağlı kısa değerlendirme notu.
  notes String?

  fileName String
  mimeType String
  /// Bayt cinsinden — liste ekranında dosya verisi okunmadan gösterilir.
  fileSize Int
  fileData Bytes

  createdByUserId String?
  createdBy       User?    @relation("ZekaTestiEkleyen", fields: [createdByUserId], references: [id], onDelete: SetNull)
  createdAt       DateTime @default(now())

  @@index([studentId, date])
}

// ---------------------------------------------------------------------------
// Kayıt
// ---------------------------------------------------------------------------

/// §2.6 — Öğrencinin bir dönem veya kulüp grubuna dahil edilmesi.
/// Kayıt türü ayrı bir alan değildir; bağlı olduğu grubun döneme mi kulübe mi
/// ait olduğundan türetilir.
model Enrollment {
  id        String  @id @default(cuid())
  studentId String
  student   Student @relation(fields: [studentId], references: [id], onDelete: Cascade)
  groupId   String
  group     Group   @relation(fields: [groupId], references: [id], onDelete: Cascade)

  /// §13.10 — Bir öğrenci aynı kayıt içinde yalnızca bir stajyere atanabilir.
  /// SetNull: stajyer hesabı silinse de kayıt ve puanlama geçmişi korunur.
  internId String?
  intern   User?   @relation("AtananStajyer", fields: [internId], references: [id], onDelete: SetNull)

  status    EnrollmentStatus @default(AKTIF)
  createdAt DateTime         @default(now())
  updatedAt DateTime         @updatedAt

  /// İptal sebebi. `null` = sebep girilmeden iptal edilmiş: dönem/kulüp
  /// sayfasındaki toplu çıkarma (düzeltme amaçlı, sebebi yok) ve bu alanlar
  /// eklenmeden önce iptal edilmiş eski kayıtlar.
  cancelReason CancelReason?
  /// Serbest açıklama — "şehir değiştirdiler" gibi. `DIGER` için zorunlu.
  cancelNote   String?
  cancelledAt  DateTime?

  /// Öğrencinin SON KATILDIĞI eğitim günü.
  ///
  /// İki alan birlikte okunur, üç durumu ayırt ederler:
  ///   ikisi de boş           → hiç katılmadan ayrıldı
  ///   tarih dolu, hafta boş  → telafi günü (telafi gününün hafta numarası yok)
  ///   ikisi de dolu          → programın o haftası
  ///
  /// Hangi atölyeleri tamamladığı buradan TÜRETİLMİYOR; o bilgi zaten
  /// `Score` satırlarında duruyor. Bu alan "kaçıncı haftada ayrıldı"
  /// sorusunun cevabı, ikinci bir katılım kaydı değil.
  lastAttendedWeek Int?
  lastAttendedDate DateTime? @db.Date

  /// §11 — Koordinatörün bu kayıt için yazdığı öğrenci geneli gözlem notu.
  ///
  /// Rapor gövdesinde DEĞİL burada duruyor: her rapor üretimi yeni bir
  /// `Report` satırı açıyor (`generatedAt` ile listeleniyor), notu rapora
  /// yazsaydık yeniden üretimde kaybolurdu. Not kayda ait, rapora değil.
  /// Oturum bazlı ayrıntılı gözlemler `Score.gozlemNotu` alanında.
  gozlemNotu String?

  scores                 Score[]
  reportLinks            ReportEnrollment[]
  developmentAssessments DevelopmentAssessment[]
  legacyReports          LegacyReport[]

  @@unique([studentId, groupId])
  @@index([groupId, status])
  @@index([internId, status])
  @@index([cancelReason])
}

// ---------------------------------------------------------------------------
// Oturum ve puanlama
// ---------------------------------------------------------------------------

/// §2.4 — Belirli bir eğitim gününde yapılan tek bir atölye.
///
/// Oturumlar grup açılırken fiziksel satır olarak üretilir (materyalize edilir):
/// dönem grubu = 10 hafta × 5 atölye = 50 satır, kulüp grubu = 3 satır.
/// Puanlama görevleri, eksik puanlama tespiti, katılım geçmişi ve raporlama
/// bu tablodan tek bir sorguyla çıkar.
model Session {
  id             String       @id @default(cuid())
  groupId        String
  group          Group        @relation(fields: [groupId], references: [id], onDelete: Cascade)
  workshopTypeId String
  workshopType   WorkshopType @relation(fields: [workshopTypeId], references: [id], onDelete: Restrict)

  /// Kulüp oturumlarında boştur; kulübün tek tarihi vardır, hafta kavramı yok.
  termWeekId String?
  termWeek   TermWeek? @relation(fields: [termWeekId], references: [id], onDelete: Cascade)

  /// Programın kaçıncı haftası — yalnızca GÖSTERİM için.
  ///
  /// Dönemde bu bilgi `termWeek` üzerinden okunuyordu ama kulüpte öyle bir
  /// bağ yok ve kulüp artık haftalara yayılabiliyor. Sayıyı oturumun üstünde
  /// tutmak iki program türünü tek okumada birleştiriyor.
  ///
  /// Telafi günlerinde BOŞ: sonradan eklenen bir gün dönemin 3. haftası
  /// değildir, arasına sıkışan fazladan bir gündür.
  weekNumber Int?

  date DateTime @db.Date

  scores Score[]

  @@unique([groupId, date, workshopTypeId])
  @@index([groupId, date])
  @@index([date])
}

/// §10 — Bir öğrencinin tek bir atölye oturumundaki değerlendirmesi.
model Score {
  id           String     @id @default(cuid())
  sessionId    String
  session      Session    @relation(fields: [sessionId], references: [id], onDelete: Cascade)
  enrollmentId String
  enrollment   Enrollment @relation(fields: [enrollmentId], references: [id], onDelete: Cascade)

  /// §10.2 — Katılım her atölye için ayrı işaretlenir. `false` ise cevap
  /// satırı yazılmaz ve oturum hiçbir ortalamaya dahil edilmez.
  attended Boolean

  /// §11 — Stajyerin bu oturuma dair serbest gözlem notu. İSTEĞE BAĞLI.
  ///
  /// Rapordaki beceri bloklarının ("Ramazan'ın … 'internet çektirir' yanıtı")
  /// tek kaynağı burası: puan 1–5 arası bir sayıdır, hangi davranışın
  /// gözlendiğini taşımaz. Yapay zekâ bu alandaki bilgiyi yeniden yazar ama
  /// buraya yazılmamış bir davranışı rapora ekleyemez.
  gozlemNotu String?

  scoredByUserId String?
  scoredBy       User?   @relation("PuanlamayiGiren", fields: [scoredByUserId], references: [id], onDelete: SetNull)

  createdAt DateTime @default(now())
  /// §13.16 — Rapor güncelliği bu alandan türetilir: kapsamdaki puanların en
  /// yeni `updatedAt` değeri raporun `generatedAt` değerinden sonraysa rapor
  /// "Güncel değil" sayılır. Ayrı bir bayrak veya arka plan işi gerekmez.
  updatedAt DateTime @updatedAt

  answers ScoreAnswer[]

  @@unique([sessionId, enrollmentId])
  @@index([enrollmentId])
  @@index([updatedAt])
}

/// §10.3 — Katıldı işaretli bir formda her soru için bir satır açılır.
///
/// İki durum kasten ayrılmıştır:
///   satır yok                 → form eksik doldurulmuş
///   satır var, `value` null   → "Değerlendirilemedi" (ortalamaya girmez)
model ScoreAnswer {
  id      String @id @default(cuid())
  scoreId String
  score   Score  @relation(fields: [scoreId], references: [id], onDelete: Cascade)

  /// §13.14 — Soru sonradan silinirse bu bağ kopar ama `questionTextSnapshot`
  /// kalır; geçmiş değerlendirme o gün sorulan metinle görüntülenmeye devam
  /// eder.
  questionId String?
  question   Question? @relation(fields: [questionId], references: [id], onDelete: SetNull)

  /// Puanlama anındaki soru metni. Soru sonradan düzenlense bile değişmez.
  questionTextSnapshot String

  /// questionTextSnapshot ilkesinin başlık ve kategori eşleri: puanlama
  /// anındaki değerler; raporlar soru tablosuna dönmeden bunları okur.
  titleSnapshot    String?
  categorySnapshot String?

  sortOrder Int @default(0)

  /// §10.3 — 1–5 arası puan. `null` = Değerlendirilemedi.
  value Int?

  @@index([scoreId, sortOrder])
}

/// Gelişim değerlendirmesinin dönem içindeki zamanı.
enum AssessmentPeriod {
  DONEM_ORTASI
  DONEM_SONU
}

/// "Sosyal Duygusal Bilişsel Beceriler" testi — stajyerin her öğrencisi için
/// dönem ortasında ve dönem sonunda bir kez doldurduğu, atölye oturumlarından
/// bağımsız değerlendirme. Yalnızca dönem kayıtları için tutulur; kulüpte
/// dönem ortası/sonu kavramı yok.
///
/// Sorular kodda sabittir (lib/gelisim-degerlendirmesi.ts); cevaplar soru
/// metnini kendi içinde taşır (`questionTextSnapshot` ilkesi,
/// `ParentMeeting.answersJson` deseni) — liste değişse de geçmiş bozulmaz.
model DevelopmentAssessment {
  id           String     @id @default(cuid())
  enrollmentId String
  enrollment   Enrollment @relation(fields: [enrollmentId], references: [id], onDelete: Cascade)

  period AssessmentPeriod

  /// `[{anahtar, kategori, baslik, soruMetni, deger}]` — deger 1–5 ya da
  /// null (Değerlendirilemedi).
  answersJson Json

  filledByUserId String?
  filledBy       User?   @relation("GelisimiDolduran", fields: [filledByUserId], references: [id], onDelete: SetNull)

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  /// Kayıt başına her dönem noktası bir kez doldurulur; tekrar kaydetme
  /// üzerine yazar (upsert).
  @@unique([enrollmentId, period])
}

// ---------------------------------------------------------------------------
// Rapor
// ---------------------------------------------------------------------------

/// §11 — Belirli bir anda üretilmiş öğrenci raporu.
model Report {
  id        String  @id @default(cuid())
  studentId String
  student   Student @relation(fields: [studentId], references: [id], onDelete: Cascade)

  generatedAt DateTime @default(now())

  /// Atölye bazlı sonuçlar ve genel değerlendirme metni. Rapor motorunun
  /// analiz çıktısı ile üretilen metin birlikte saklanır; koordinatör metni
  /// düzenlediğinde analiz kısmı bozulmaz.
  bodyJson Json

  editedByUserId String?
  editedBy       User?     @relation("RaporuDuzenleyen", fields: [editedByUserId], references: [id], onDelete: SetNull)
  editedAt       DateTime?

  createdAt DateTime @default(now())

  enrollmentLinks ReportEnrollment[]
  pdfs            ReportPdf[]

  @@index([studentId, generatedAt])
}

/// §11.5 — Raporun hangi kayıtları kapsadığı. Bir rapor birden fazla dönem
/// veya kulüp kaydını birlikte değerlendirebilir.
model ReportEnrollment {
  id           String     @id @default(cuid())
  reportId     String
  report       Report     @relation(fields: [reportId], references: [id], onDelete: Cascade)
  enrollmentId String
  enrollment   Enrollment @relation(fields: [enrollmentId], references: [id], onDelete: Cascade)

  @@unique([reportId, enrollmentId])
}

/// §13.17 — Üretilmiş PDF'ler asla silinmez.
///
/// `onDelete: Restrict` bunu veritabanı seviyesinde zorlar: PDF'i olan bir
/// rapor (dolayısıyla o öğrenci) silinemez. Öğrenciler zaten kalıcı olarak
/// silinmemeli; silme ihtiyacı doğarsa arşivleme kullanılır.
model ReportPdf {
  id       String @id @default(cuid())
  reportId String
  report   Report @relation(fields: [reportId], references: [id], onDelete: Restrict)

  fileUrl String

  /// PDF üretildiği andaki rapor içeriğinin tam kopyası. Rapor sonradan
  /// düzenlense bile PDF'in neye dayandığı geriye dönük görülebilir.
  snapshotJson Json

  createdAt DateTime @default(now())

  @@index([reportId, createdAt])
}

/// Panel açılmadan önce, dışarıda (Excel'de) üretilmiş öğrenci değerlendirme
/// raporu. Amaç yalnızca GEÇMİŞİ TAKİP: öğrencinin profilinde hangi dönemde
/// hangi sınıfta olduğu ve o dönemin raporu görülebilsin.
///
/// Neden `Report`/`ReportPdf` değil: onların `bodyJson`/`snapshotJson` alanları
/// zorunlu ve bu belgelerin öyle bir gövdesi yok — bu dönemlerin puanlaması da
/// müfredatı da hiç girilmedi. Sahte JSON yazmak rapor motorunu kirletir ve
/// "yeniden üret" düğmesi anlamsız bir belge üretirdi. Bağlı oldukları dönem
/// `Term.gecmisVerisi` ile zaten rapor üretimine kapalı.
///
/// DOSYA: ikili veri doğrudan veritabanında — `IntelligenceTest` ile aynı
/// gerekçe ve aynı desen (nesne deposu kurulmadı). 351 belge ≈ 133 MB.
model LegacyReport {
  id        String  @id @default(cuid())
  studentId String
  student   Student @relation(fields: [studentId], references: [id], onDelete: Cascade)

  /// Hangi kayda ait olduğu biliniyorsa bağlanır. Excel'de karşılığı olmayan
  /// (yalnız PDF'ten tanınan) öğrencilerde boş kalır; belge yine de öğrenciye
  /// bağlı durur.
  enrollmentId String?
  enrollment   Enrollment? @relation(fields: [enrollmentId], references: [id], onDelete: SetNull)

  /// Anlık kopyalar — dönem/grup sonradan yeniden adlandırılsa da belge
  /// kapağındaki bilgi değişmez.
  termLabel  String
  groupLabel String?

  /// Raporun ait olduğu tarih (PDF'in üretim tarihi).
  reportDate DateTime @db.Date

  /// Aktarımın izi: orijinal klasör + dosya adı. Aynı yol iki kez
  /// aktarılmaz — betiğin idempotanlığı buna dayanır.
  sourcePath String @unique

  fileName  String
  mimeType  String
  fileSize  Int
  fileData  Bytes
  createdAt DateTime @default(now())

  @@index([studentId, reportDate])
}

// ---------------------------------------------------------------------------
// Rapor içeriği — öğrenciye özel OLMAYAN metinler
// ---------------------------------------------------------------------------

/// §11.2 — "Atölyeler ve İçerikleri Hakkında" bölümünün paragrafları.
///
/// Bu metin ÖĞRENCİYE ÖZEL DEĞİLDİR: bir programın bir atölyesinin o dönem
/// boyunca ne işlediğini anlatır, dolayısıyla o programdaki bütün öğrenciler
/// aynı paragrafı görür. Bu yüzden rapor gövdesinde değil burada duruyor —
/// aksi halde aynı metin yüzlerce rapor satırına kopyalanır ve bir düzeltme
/// için hepsinin yeniden üretilmesi gerekirdi.
///
/// Kaynağı `CurriculumEntry` satırlarıdır (hafta × atölye); yapay zekâ o
/// haftaların başlık ve açıklamalarını tek paragrafa çevirir.
model AtolyeIcerigi {
  id String @id @default(cuid())

  /// `CurriculumEntry` ile aynı kural: dönem VEYA kulüp, tam olarak biri dolu.
  termId String?
  term   Term?   @relation(fields: [termId], references: [id], onDelete: Cascade)
  clubId String?
  club   Club?   @relation(fields: [clubId], references: [id], onDelete: Cascade)

  workshopTypeId String
  /// Restrict: programda kullanılan atölye çeşidi silinemez (TermWorkshop
  /// ve CurriculumEntry ile aynı kural).
  workshopType   WorkshopType @relation(fields: [workshopTypeId], references: [id], onDelete: Restrict)

  metin String

  /// Metnin nasıl üretildiği. `elle` değeri koordinatörün düzenlediğini
  /// gösterir; yeniden üretimde bu ayrım kullanıcıya gösterilir.
  kaynak String @default("ai")

  /// Kilitliyken toplu yeniden üretim bu satırı atlar. Koordinatör metni
  /// onayladıktan sonra kazara üzerine yazılmasını engeller.
  kilitli Boolean @default(false)

  uretenUserId String?
  ureten       User?   @relation("AtolyeIcerigiUreten", fields: [uretenUserId], references: [id], onDelete: SetNull)

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  // Program × atölye başına TEK paragraf. NULL sütun unique'e girmediği için
  // dönem ve kulüp satırları iki ayrı indeksle kısıtlanır (CurriculumEntry
  // ile aynı desen).
  @@unique([termId, workshopTypeId])
  @@unique([clubId, workshopTypeId])
}

/// §11.2 — Rapordaki beceri bloklarının sabit tanım metinleri.
///
/// Örn. ad "Akıl Yürütme", tanım "çocuğun bilgisini kullanarak hem duruma hem
/// de normlara uygun yeni bilgi üretme sürecidir…". Bu metinler öğrenciden
/// bağımsızdır ve her raporda aynen basılır.
///
/// Kodda sabit tutulmadı: metin veliye gidiyor, kurum dili zamanla
/// değişebiliyor ve koordinatörün bir düzeltme için yayın beklemesi gerekmez.
model BeceriTanimi {
  id    String @id @default(cuid())
  ad    String @unique
  tanim String

  sortOrder Int     @default(0)
  active    Boolean @default(true)

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  @@index([active, sortOrder])
}

/// §11.2 — Rapor sonundaki "ev ortamında öneriler" bölümünün ürün kataloğu.
///
/// NEDEN TABLO: yapay zekâya serbest bırakılsaydı var olmayan ürün adı
/// uydurabilirdi ve bu metin veliye gidiyor. Sistem önce yaş ve beceri
/// eşleşmesine göre aday ürünleri seçer; yapay zekâ yalnızca kendisine
/// verilen bu adaylardan seçebilir, uygun aday yoksa ürün adı vermeden genel
/// öneri yazar.
model OneriUrunu {
  id  String @id @default(cuid())
  ad  String
  url String

  /// kitap | oyun | set | materyal
  kategori String

  /// Ürün adında yazan yaş aralığı esas alınır — veli onu görecek. (Katalogda
  /// yaş üç ayrı yerde ve bazen çelişkili yazıyor.)
  yasMin Int
  yasMax Int

  /// DUYGUSAL | SOSYAL | BILISSEL — birden fazla olabilir.
  alanlar String[]

  /// Puanlama sorularının kısa başlıklarıyla eşleşen beceri etiketleri.
  beceriler String[]

  aciklama String?

  /// Ürünün bir atölyeyle doğrudan bağı varsa (örn. Torappu → Zekâ ve Akıl
  /// Oyunları Atölyesi). En güçlü öneri tipi bu: "atölyede oynadığı oyunun
  /// ev versiyonu".
  workshopTypeId String?
  workshopType   WorkshopType? @relation(fields: [workshopTypeId], references: [id], onDelete: SetNull)

  active Boolean @default(true)

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  @@index([active, yasMin, yasMax])
}

// ---------------------------------------------------------------------------
// Rapor ayarları
// ---------------------------------------------------------------------------

/// §11.2 — Rapor kademe eşikleri, kıyas kuralı ve kademe etiketleri.
///
/// Bu değerler eskiden `rapor-bantlari.ts` içinde sabitti: kurum bir
/// ortalamanın hangi noktadan sonra "Yüksek" sayılacağını, kaç kişilik bir
/// grupta akran kıyası yapılabileceğini ya da en alt kademenin veliye nasıl
/// adlandırılacağını ("Düşük" mü, "Gelişmekte" mi) değiştiremiyordu.
///
/// TEK SATIR: `id` sabit `"tek"`. Satır hiç yoksa kod kendi varsayılanlarını
/// kullanır (`VARSAYILAN_ESIKLER`), yani ayar sayfası hiç açılmadan da sistem
/// çalışır. Şube başına ayrı değer TUTULMAZ — rapor kurumun belgesi ve iki
/// şubede aynı ölçütle okunmalı (atölye kataloğuyla aynı gerekçe).
///
/// GEÇMİŞ RAPORLAR ETKİLENMEZ: kademeler üretim anında `bodyJson` içine
/// donuyor (§13.17). Ayar değişikliği yalnızca bundan sonra üretilecek
/// raporlara işler; eskisini taşımak için "güncel puanlarla yeniden üret"
/// gerekir.
model RaporAyari {
  id String @id @default("tek")

  /// Atölye ilgi/başarı kademesi — mutlak eşik, akran kıyası yok.
  /// Ortalama >= yüksek eşiği ise Yüksek, < düşük eşiği ise Düşük.
  atolyeYuksekEsigi Float @default(4.0)
  atolyeDusukEsigi  Float @default(3.0)

  /// Gelişim alanları grupla kıyaslanır: öğrenci ile grup ortalaması
  /// arasındaki fark bu değeri aşarsa Yüksek, eksisini aşarsa Düşük.
  gelisimFarkEsigi Float @default(0.25)

  /// Aynı öğrencinin dönem ortası ile dönem sonu ölçümü arasındaki farkın
  /// "belirgin ilerleme" sayılma eşiği. `gelisimFarkEsigi` akran kıyasını
  /// ölçer, bu alan öğrencinin kendi değişimini — ikisi ayrı sorular.
  gelisimIlerlemeEsigi Float @default(0.3)

  /// İlgi ile başarı arasındaki farkın "belirgin asimetri" sayılma eşiği.
  asimetriEsigi Float @default(0.75)

  /// Akran kıyasının yapılabilmesi için grupta dönem sonu değerlendirmesi
  /// girilmiş en az kaç öğrenci gerektiği (raporun öğrencisi dahil). Altında
  /// kalınırsa kıyas yapılmaz ve rapor mutlak eşiklere düşer.
  kiyasAsgariOgrenci Int @default(3)

  /// Kademelerin veliye yazılan adları.
  etiketYuksek   String @default("Yüksek")
  etiketOrtalama String @default("Ortalama")
  etiketDusuk    String @default("Düşük")

  updatedAt       DateTime @updatedAt
  updatedByUserId String?
  updatedBy       User?    @relation("RaporAyariniGuncelleyen", fields: [updatedByUserId], references: [id], onDelete: SetNull)
}

// ---------------------------------------------------------------------------
// Adaylar (CRM) — §16
// ---------------------------------------------------------------------------

/// §16.2 — Aday boru hattının aşamaları. Sıra ekran sırasıdır.
///
/// İzinli geçişlerin tek kaynağı `src/lib/aday-durumlari.ts` içindeki
/// `ADAY_ASAMA_GECISLERI` haritasıdır (dönem/kulüp durumlarındaki desen).
/// KAZANILDI yalnızca dönüşüm akışıyla yazılır ve terminaldir; KAYBEDILDI
/// yeniden açılabilir (yanlışlıkla kapatma telafisi).
enum LeadStage {
  YENI
  ULASILDI
  RANDEVU_VERILDI
  GORUSME_YAPILDI
  KAZANILDI
  KAYBEDILDI
}

/// §16.1 — Adayın nereden geldiği. META ve WEB_SITESI yalnızca API girişinden
/// yazılır; elle açılan adayda TELEFON / YOLDAN_GECEN / DIGER seçilir (Zod
/// şeması elle girişte ilk ikisini kabul etmez). "Bu ay Meta'dan kaç aday
/// geldi ve kaçı kazanıldı" sorusu ancak sayılabilir bir alandan cevaplanır.
enum LeadSource {
  META
  WEB_SITESI
  TELEFON
  YOLDAN_GECEN
  DIGER
}

/// §16.4 — Kaybediliş sebebi (`CancelReason` ilkesi: serbest metin yerine
/// etiket, liste bilerek kısa, DIGER'de açıklama zorunlu — CHECK ile).
/// "RAKIP" bilerek yok: veli söylemezse bilinemez; `VAZGECTI` + not yeter.
enum LeadLossReason {
  ULASILAMADI
  FIYAT
  UZAKLIK
  PROGRAM_UYGUN_DEGIL
  VAZGECTI
  YANLIS_KAYIT
  DIGER
}

/// §16.3 — Etkinlik türü. ULASILAMADI ayrı tür çünkü "kaç deneme boşa gitti"
/// sayılabilir olmalı; ARAMA ulaşılan görüşmedir. ASAMA_DEGISIMI ve SISTEM
/// satırlarını yalnızca kod yazar, form yazamaz (CHECK + eylem şemaları).
enum LeadActivityType {
  ARAMA
  ULASILAMADI
  WHATSAPP
  NOT
  ASAMA_DEGISIMI
  SISTEM
}

/// §16.5 — API girişinde oluşan durum. TAMAM dışındaki her değer "ilgilenilmeli"
/// demektir ve listede yönetici uyarısı üretir: ESLEME_YOK = şube kodu
/// çözülemedi, varsayılan şubeye yazıldı; EKSIK_VERI = ulaşılabilir hiçbir
/// kanal (telefon/e-posta) gelmedi. Aday hiçbir koşulda düşürülmez — eksik
/// kayıt, kaybolan başvurudan iyidir.
enum LeadIngestStatus {
  TAMAM
  ESLEME_YOK
  EKSIK_VERI
}

/// §16 — Aday (lead): henüz kayda dönüşmemiş ilgi. Şube sınırının dördüncü
/// doğrudan durduğu tablo (`User`/`Group`/`Student`'a ek): aday daha öğrenci
/// olmadan bir şubenin telefon listesine düşer, şubesi türetilebileceği bir
/// üst kayıt yok.
///
/// Kaynaklar üç kapıdan yazar (§16.1): entegratör (Meta reklam formları),
/// web sitesi formu ve panelde elle giriş. Üçü de `src/lib/aday/aday-kaydi.ts`
/// içindeki ortak `adayYaz()` fonksiyonundan geçer — mükerrer kararı ve
/// telefon normalizasyonu tek yerde yaşar.
model Lead {
  id String @id @default(cuid())

  branchId String
  branch   Branch @relation(fields: [branchId], references: [id], onDelete: Restrict)

  /// Görüşülen kişi (veli). Nullable: Meta formu ad sorusu taşımayabilir;
  /// arayüz boş adı "İsimsiz aday" olarak gösterir. Elle giriş ve web
  /// formunda Zod zorunlu kılar.
  parentName String?
  childName  String?
  /// Formda soruluyorsa çocuğun yaşı — doğum tarihi aday aşamasında sorulmaz,
  /// dönüşümde öğrenci formunda alınır.
  childAge Int?

  /// Meta'dan telefonsuz form gelebilir; elle giriş ve web formunda zorunlu.
  phone String?
  /// §6.2 ile aynı ilke — `normalizeTelefon()` çıktısı, `Guardian.searchPhone`
  /// ile aynı biçim: mükerrer kontrolü iki tabloyu aynı anahtarla tarar.
  searchPhone String?
  email       String?

  /// Arama kutusu için: `normalizeArama(veliAdi + " " + cocukAdi)`. İki ad da
  /// boşsa boş dize — arama bulamaz ama satır telefonla bulunur.
  searchName String

  /// İlgilenilen program — serbest metin. Katalog FK'sı değil: aday "yaz
  /// kampı var mı" diye arar, kurum yelpazesi dönemden döneme değişir.
  interestedProgram String?
  /// Formdaki mesaj/ek sorular — eşlenemeyen alanlar satır satır buraya iner.
  message String?

  source LeadSource
  /// Kampanya/form adının ANLIK KOPYASI (`questionTextSnapshot` ilkesi):
  /// kampanya Meta'da silinse de "hangi reklamdan geldi" bilgisi kalır.
  sourceDetail String?

  /// Meta leadgen kimliği — entegratör iletir. Teslim tekrarlarında ve
  /// entegratörün yeniden denemelerinde idempotency anahtarı: aynı kimlikle
  /// ikinci yazım sessizce yutulur (upsert).
  externalId String? @unique

  /// API'den gelen ham gövdenin tam kopyası — alan eşlemesi tartışılırsa
  /// kanıt burada. Elle girişte boş.
  rawJson Json?

  ingestStatus LeadIngestStatus @default(TAMAM)
  ingestNote   String?

  /// KVKK açık rızası. Web formunda onay kutusu zorunlu; Meta formunda
  /// aydınlatma metni Meta'nın gizlilik alanından sunulur ve entegratör
  /// onayı iletir. Elle girişte sözlü bilgilendirme varsayılır (false kalır).
  kvkkConsent Boolean   @default(false)
  consentAt   DateTime?

  stage LeadStage @default(YENI)

  /// Kayıp alanları yalnız KAYBEDILDI'de dolu; orada sebep + damga zorunlu
  /// (`Lead_kayip_alanlari` CHECK). DIGER sebebinde not zorunlu.
  lossReason LeadLossReason?
  lossNote   String?
  lostAt     DateTime?

  /// Ulaşılamayan ARDIŞIK arama denemesi sayısı. ULASILAMADI etkinliğiyle
  /// aynı işlemde artar, ULASILDI'ya geçişte sıfırlanır. Etkinlik geçmişi
  /// zaten tam kayıt; bu alan liste ekranındaki "3. deneme" rozetinin
  /// indekslenebilir kopyasıdır (denormalizasyon bilinçli).
  unreachableCount Int       @default(0)
  lastContactAt    DateTime?

  /// Verilen randevunun zamanı — RANDEVU_VERILDI'ye geçerken alınır.
  appointmentAt DateTime?

  /// §16.6 — Takip görevi: "bugün aranacaklar" kuyruğu bu alandan okunur
  /// (bugün ve öncesi). Boşsa aday kuyruğa hiç düşmez.
  nextActionDate DateTime? @db.Date
  nextActionNote String?

  /// Sorumlu danışman. Görünürlüğü KISITLAMAZ (küçük ekip, herkes her adayı
  /// görür) — iş bölümü ve süzgeç içindir. Elle açılan aday açana atanır,
  /// API'den gelen atanmamış düşer.
  assignedToUserId String?
  assignedTo       User?   @relation("AdayiUstlenen", fields: [assignedToUserId], references: [id], onDelete: SetNull)

  /// KAZANILDI damgası `convertedAt`tir (CHECK oradan okur); öğrenci FK'sı
  /// SetNull ile kopabilir ama damga kalır — dönüştürülen öğrenci silinse de
  /// "bu aday kazanılmıştı" bilgisi ve kaynak raporu bozulmaz.
  convertedStudentId String?   @unique
  convertedStudent   Student?  @relation(fields: [convertedStudentId], references: [id], onDelete: SetNull)
  convertedAt        DateTime?

  /// Elle açan kullanıcı; API girişinde null (görüşme kayıtlarındaki desen).
  createdByUserId String?
  createdBy       User?   @relation("AdayiEkleyen", fields: [createdByUserId], references: [id], onDelete: SetNull)

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  activities LeadActivity[]

  @@index([branchId, stage, nextActionDate])
  @@index([branchId, searchPhone])
  @@index([branchId, searchName])
  @@index([branchId, source, createdAt])
}

/// §16.3 — Aday etkinlik günlüğü: arama/whatsapp/not + otomatik aşama izi.
/// Görüşme kayıtları ilkesi: satır silinmez ve düzenlenmez — yanlış not yeni
/// notla düzeltilir. Aday silme eylemi V1'de yok (spam `KAYBEDILDI +
/// YANLIS_KAYIT` ile kapanır), Cascade yalnızca ileride bilinçli bir yönetici
/// temizliği için duruyor.
model LeadActivity {
  id     String @id @default(cuid())
  leadId String
  lead   Lead   @relation(fields: [leadId], references: [id], onDelete: Cascade)

  type LeadActivityType
  note String?

  /// Yalnızca ASAMA_DEGISIMI satırlarında dolu (CHECK). Enum değerleri
  /// yeniden adlandırılmadığı için (Role şerhindeki karar) enum çifti anlık
  /// kopya görevi görür; görünen etiket `ADAY_ASAMALARI`'ndan okunur.
  fromStage LeadStage?
  toStage   LeadStage?

  /// null = sistem yazdı (API girişi, otomatik mükerrer notu).
  createdByUserId String?
  createdBy       User?    @relation("AdayEtkinliginiEkleyen", fields: [createdByUserId], references: [id], onDelete: SetNull)
  createdAt       DateTime @default(now())

  @@index([leadId, createdAt])
}

// ---------------------------------------------------------------------------
// §17 — Randevu yönetimi: hizmet kataloğu, uzmanlar ve izinler.
//
// Kurumun ikinci iş kolu (zekâ testleri ve bireysel danışmanlık seansları)
// bu bölümde tanımlanır. Randevunun kendisi (§17.4) ikinci fazda eklenecek;
// buradaki tablolar onun ön koşuludur.
// ---------------------------------------------------------------------------

/// Hizmetin hangi işe ait olduğu. Rapor kırılımı ve randevu formunun
/// gruplaması bu alandan gelir.
enum HizmetGrubu {
  /// Tek seferlik uygulanır, otomatik tekrar kapsamı dışındadır.
  TEST
  /// Düzenli seans hâlinde sürer; haftalık tekrara açıktır.
  DANISMANLIK
  /// Atölye görüşmeleri — ücretsiz sunulur.
  ATOLYE
}

/// Hizmetin danışanı kim: çocuk mu, veli mi.
///
/// Randevu her hâlükârda VELİYE açılır (§17.4) — ödeyen, arayan ve hatırlatma
/// mesajını alan taraf o. Bu alan çocuk seçiminin zorunlu olup olmadığını ve
/// hatırlatma metninin kimden bahsettiğini belirler: oyun temelli
/// danışmanlıkta seansa çocuk girer, aile danışmanlığında velinin kendisi.
enum DanisanTuru {
  COCUK
  VELI
}

/// §17.2 — Hizmet kataloğu: süre, ücret ve yaş aralığı.
///
/// Sabit bir enum DEĞİL, veritabanından yönetilen katalog
/// (`IntelligenceTestType` deseni). Gerekçe: kurumun hizmet adları ve
/// fiyatları kod sürümünden bağımsız değişiyor — "Ergoterapi" bir dönem
/// "Duyu Bütünleme Programı" olarak anılmaya başladı ve bu tek başına bir
/// migration'a değmez. Mevcut `TherapyType` enum'ı KALDIRILMADI: eski
/// `CounselingSession` kayıtları ona bağlı; eşleme `lib/terapi-turleri.ts`
/// içindedir.
///
/// Hizmet ŞUBEDEN BAĞIMSIZ: fiyat listesi kurumun tamamı için tek.
model Hizmet {
  id String @id @default(cuid())

  ad   String      @unique
  grup HizmetGrubu

  /// Seans süresi DAKİKA cinsinden. Randevunun bitiş saati bundan türetilir
  /// ve kayda donar; hizmetin süresi sonradan değişse eski randevu kaymaz.
  sureDk Int

  /// Ücret KURUŞ cinsinden tamsayı. Para hiçbir yerde `Float` tutulmaz:
  /// 3200.00 TL gibi değerler ikilik kayan noktada tam temsil edilmiyor ve
  /// ciro toplamı kuruş kaydırıyor. ₺3.200,00 = 320000.
  ucretKurus Int @default(0)

  /// Hizmetin uygulanabildiği yaş aralığı (yıl); boş = sınır yok. Randevu
  /// formunda uyarı üretir, engellemez — kurum istisna yapabiliyor.
  yasAlt Int?
  yasUst Int?

  danisanTuru DanisanTuru @default(COCUK)

  /// Haftalık otomatik tekrar kapsamında mı. Danışmanlıklarda her danışanın
  /// sabit bir seans saati var ve seans bir sonraki haftaya kendiliğinden
  /// eklenir; zekâ testleri tek seferliktir ve her seferinde elle girilir.
  tekrarli Boolean @default(false)

  aktif     Boolean @default(true)
  sortOrder Int     @default(0)

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  uzmanlar UzmanHizmet[]

  @@index([aktif, sortOrder])
}

/// Uzmanın çalışma düzeni. Mesai tanımı zaten haftalık saatleri veriyor;
/// bu alan raporlamada ve listede ayrım için tutulur (belge §1.1).
enum CalismaTipi {
  TAM_ZAMANLI
  YARI_ZAMANLI
}

/// §17.3 — Uzman: seansı veren kişi.
///
/// `User` DEĞİL, ayrı bir kayıt. İki gerekçe: (1) uzmanların bir kısmı panele
/// hiç girmiyor, onlara hesap ve parola açmak gereksiz bir güvenlik yüzeyi;
/// (2) `User` tek şubeye bağlı (veritabanı CHECK'i) ama uzman iki şubede
/// birden çalışabiliyor. Panele giren uzman için `userId` doldurulur.
///
/// Uzman ŞUBEDEN BAĞIMSIZ tabloda durur; şube bağı `UzmanSube` üzerinden
/// kurulur (bkz. lib/sube-sizinti.ts gerekçesi).
model Uzman {
  id String @id @default(cuid())

  ad String

  /// Takvimde uzmanları ayırt eden renk. Serbest hex DEĞİL, sabit paletten
  /// bir anahtar (`lib/uzman-renkleri.ts`): tasarım dilinde anlam renkleri
  /// (emerald = olumlu, red = hata) ayrılmış durumda ve rastgele bir hex o
  /// anlamların üstüne binerdi.
  renk String

  calismaTipi CalismaTipi @default(TAM_ZAMANLI)

  /// Panele giren uzmanın hesabı. Boş olabilir — çoğu uzman girmiyor.
  userId String? @unique
  user   User?   @relation("UzmanHesabi", fields: [userId], references: [id], onDelete: SetNull)

  aktif     Boolean @default(true)
  sortOrder Int     @default(0)

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  subeler  UzmanSube[]
  hizmetler UzmanHizmet[]
  mesailer UzmanMesai[]
  izinler  Izin[]

  @@index([aktif, sortOrder])
}

/// Uzmanın çalıştığı şubeler. Çoktan çoğa: bir uzman iki şubede birden
/// çalışabiliyor (belge §1.4).
model UzmanSube {
  uzmanId String
  uzman   Uzman  @relation(fields: [uzmanId], references: [id], onDelete: Cascade)
  subeId  String
  sube    Branch @relation(fields: [subeId], references: [id], onDelete: Cascade)

  @@id([uzmanId, subeId])
  @@index([subeId])
}

/// §17.3 — Uzmanın yetkinliği: hangi test ve hizmetleri uygulayabiliyor.
///
/// Randevu formu yalnız bu listeyi gösterir ve sunucu da aynı listeye karşı
/// doğrular — belgedeki "hatalı atamaların önüne geçer" kuralı.
model UzmanHizmet {
  uzmanId  String
  uzman    Uzman  @relation(fields: [uzmanId], references: [id], onDelete: Cascade)
  hizmetId String
  hizmet   Hizmet @relation(fields: [hizmetId], references: [id], onDelete: Cascade)

  @@id([uzmanId, hizmetId])
  @@index([hizmetId])
}

/// Uzmanın haftalık çalışma saatleri — ŞUBE BAŞINA ayrı.
///
/// Çift şubeli uzman salı Ümraniye'de, perşembe Güneşli'de olabiliyor;
/// tek bir haftalık takvim bunu anlatamazdı.
///
/// Saatler GECE YARISINDAN İTİBAREN DAKİKA cinsinden tamsayı (540 = 09:00).
/// `DateTime` yerine sayı: "bu randevu mesai içinde mi" sorusu saat
/// aritmetiği gerektiriyor ve tarihsiz bir saati `DateTime` ile taşımak
/// sahte bir güne yaslanmak demekti.
model UzmanMesai {
  id      String @id @default(cuid())
  uzmanId String
  uzman   Uzman  @relation(fields: [uzmanId], references: [id], onDelete: Cascade)
  subeId  String
  sube    Branch @relation(fields: [subeId], references: [id], onDelete: Cascade)

  gun         Day
  baslangicDk Int
  bitisDk     Int

  @@index([uzmanId, gun])
}

/// §17.3 — Uzman izni.
///
/// Eski CRM izni ₺0 / 0 dakikalık sahte bir HİZMET olarak tutuyordu; burada
/// kendi tablosunda. Gerekçe: izin bir seans değil, seans sayısı ve ciro
/// raporlarına karışmamalı — sahte hizmet her raporda ayrıca dışlanmayı
/// gerektirirdi ve bir gün biri dışlamayı unuturdu.
///
/// Aralık kapalı-açık: `baslangic` dahil, `bitis` hariç. Tam gün izin
/// 00:00'dan ertesi gün 00:00'a yazılır.
model Izin {
  id      String @id @default(cuid())
  uzmanId String
  uzman   Uzman  @relation(fields: [uzmanId], references: [id], onDelete: Cascade)

  baslangic DateTime
  bitis     DateTime

  sebep String?

  createdByUserId String?
  createdBy       User?    @relation("IzniEkleyen", fields: [createdByUserId], references: [id], onDelete: SetNull)
  createdAt       DateTime @default(now())

  @@index([uzmanId, baslangic])
}
